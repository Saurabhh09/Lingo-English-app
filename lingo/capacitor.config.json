{
  "appId": "com.lingoplay.app",
  "appName": "Lingo Play & Learn",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#10b981",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#faf8f0"
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}