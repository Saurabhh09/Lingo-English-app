# Optional for demo mode. Set both values to switch all storage to Supabase.
# Copy this file to .env. Keep .env private and never use VITE_ for these keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI Question Generation and Practice Lab Providers
# Set GEMINI_API_KEY to enable Google Gemini-based question generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternatively, configure OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
