# Optional for demo mode. Set both values to switch all storage to Supabase.
# Copy this file to .env. Keep .env private and never use VITE_ for these keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI Question Generation and Practice Lab Providers
# Set GEMINI_API_KEY to enable Google Gemini-based question generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternatively, configure OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated usernames permitted to call /api/admin/* endpoints
ADMIN_USERNAMES=

# Optional comma-separated extra CORS origins beyond Vercel prod and Capacitor
ALLOWED_ORIGINS=

# Optional Sentry DSN for privacy-scrubbed server 5xx reporting in production
SENTRY_DSN=

# Minimum Android versionCode required before clients are prompted to update
MIN_APK_VERSION_CODE=1
